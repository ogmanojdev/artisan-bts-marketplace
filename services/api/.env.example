PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/artisan
GCP_PROJECT_ID=local-project
GCP_REGION=asia-south1
# Local: buckets live in the fake-gcs-server container from docker-compose.yml.
# Against real GCS, remove STORAGE_EMULATOR_HOST and use the Terraform bucket names.
STORAGE_EMULATOR_HOST=http://localhost:4443
RAW_BUCKET=artisan-raw
MEDIA_BASE_URL=http://localhost:4443/artisan-media
TRANSCODE_JOB_NAME=artisan-transcoder
ALLOWED_ORIGINS=http://localhost:8081
# Leave the Razorpay keys empty locally: orders are then confirmed by the dev payment route.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Local only: accept "Bearer dev:<uid>:<artisan|buyer>" tokens
DEV_AUTH=true
