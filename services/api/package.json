{
  "name": "@artisan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.js --packages=external --alias:@artisan/shared=../../packages/shared/src/index.ts",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@artisan/shared": "*",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@google-cloud/pubsub": "^6.2.0",
    "@google-cloud/run": "^4.1.1",
    "@google-cloud/storage": "^8.4.0",
    "fastify": "^5.12.5",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.2.0",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  }
}
